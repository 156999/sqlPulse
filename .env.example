# SQL Pulse 配置示例：复制为 .env 后按需修改
# 本地开发时，被测 MySQL 跑在宿主机/本地 docker，使用下面的 TARGET_DB_* 直连
TARGET_DB_HOST=localhost
TARGET_DB_PORT=3306
TARGET_DB_USER=root
TARGET_DB_PASSWORD=mysql123456
TARGET_DB_NAME=sqlpulse_demo

# docker compose 一键部署（deploy.sh / docker compose up）使用
# WEB_PORT 为网页访问端口，MYSQL_HOST_PORT 为宿主机侧 MySQL 端口（容器内仍为 3306）
WEB_PORT=8080
MYSQL_ROOT_PASSWORD=s3cret
MYSQL_HOST_PORT=3307

# 造数
DATAGEN_SCRIPT_EXECUTION_ENABLED=false   # Shell 造数默认关闭；受信内网使用时可改为 true
DATAGEN_SQL_TIMEOUT_SEC=300
DATAGEN_SCRIPT_TIMEOUT_SEC=3600

# 认证（生产必须设置 APP_SECRET_KEY，可用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
AUTH_ENABLED=true
APP_SECRET_KEY=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SESSION_COOKIE=sqlpulse_session
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTER=true
AUTH_SEED_ROOT=true

# 部署到公网前务必修改 MYSQL_ROOT_PASSWORD，并考虑：
# AUTH_COOKIE_SECURE=true（有 HTTPS 反向代理时）
# AUTH_ALLOW_REGISTER=false（不需要开放注册时）
