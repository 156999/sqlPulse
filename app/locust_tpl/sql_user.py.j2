import os, pymysql, time
from locust import User, task, between, events

DSN = {
  "host": os.environ["TARGET_DB_HOST"], "port": int(os.environ.get("TARGET_DB_PORT","3306")),
  "user": os.environ["TARGET_DB_USER"], "password": os.environ["TARGET_DB_PASSWORD"],
  "database": os.environ["TARGET_DB_NAME"], "autocommit": True,
}

# Import the same compiler used by API preflight, including from generated files.
import sys
sys.path.insert(0, {{ project_root | tojson }})
from app.services.sql_params import compile_tasks
_DEFINITIONS, _TASKS = compile_tasks({{ tasks | tojson }}, {{ variables | tojson }})

class SqlUser(User):
    wait_time = between(0.01, 0.05)

    def on_start(self):
        self.db = pymysql.connect(**DSN)

    def on_stop(self):
        try:
            self.db.close()
        except Exception:
            pass

    def _exec(self, sql_id):
        start = time.perf_counter()
        try:
            values = {name: generator.sample({}) for name, generator in _DEFINITIONS.items()}
            with self.db.cursor() as cur:
                for statement in _TASKS[sql_id]:
                    cur.execute(*statement.bind(values))
            self.environment.events.request.fire(
                request_type="SQL", name=sql_id,
                response_time=(time.perf_counter()-start)*1000,
                response_length=0)
        except Exception as e:
            try:
                self.db.rollback()
            except Exception:
                pass
            self.environment.events.request.fire(
                request_type="SQL", name=sql_id, exception=e,
                response_time=(time.perf_counter()-start)*1000,
                response_length=0)

{% for t in tasks %}
    @task({{ t.weight }})
    def {{ t.sql_id }}(self):
        self._exec("{{ t.sql_id }}")
{% endfor %}
